<header class="main-header">
    
    <div class="logo-container">
      <a href="/">
        <img src="/logo.png" alt="Libas e ikhlaq Logo" class="brand-logo">
      </a>
    </div>
    
    <div class="brand-title-container">
        <div class="brand-title-ur" dir="rtl">لباس اخلاق</div>
        <div class="brand-title-en">LIBAS-E-IKHLAQ</div>
    </div>
    
    <div class="header-icons">
        <i class="fa-solid fa-magnifying-glass" title="Search"></i>
        <i class="fa-regular fa-heart" title="Wishlist"></i>
        
        <% if (currentUser) { %>
            <span style="font-size: 12px; font-weight: bold; margin: 0 10px;">
                Hi, <%= currentUser.name.split(' ')[0] %>!
            </span>
            
            <% if (currentUser.role === 'admin') { %>
                <a href="/admin" style="color: #d1411e; text-decoration: none; margin-right: 10px;" title="Admin Dashboard">
                    <i class="fa-solid fa-shield-halved"></i>
                </a>
            <% } %>

            <a href="/logout" style="color: inherit; text-decoration: none;" title="Logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        <% } else { %>
            <a href="/login" style="color: inherit; text-decoration: none;" title="Login/Register">
                <i class="fa-regular fa-user"></i>
            </a>
        <% } %>

        <i class="fa-solid fa-bag-shopping" title="Cart"></i>
    </div>
    
</header>